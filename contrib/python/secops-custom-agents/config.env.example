# GCP & Vertex AI Agent Engine Configuration
PROJECT_ID=your-gcp-project-id
DEFAULT_REGION=us-central1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True

# Model & Topology Configuration
MODEL_NAME=gemini-2.5-flash
SECOPS_USE_PERSONAS=true

# Google Security Operations (SecOps OneMCP) Configuration
# Populate CHRONICLE_CUSTOMER_ID (UUID) to enable live SIEM/SOAR tools.
CHRONICLE_PROJECT_ID=your-gcp-project-id
CHRONICLE_CUSTOMER_ID=<TODO: update-this-value>
CHRONICLE_REGION=us
SECOPS_ONEMCP_URL=https://chronicle.us.rep.googleapis.com/mcp

# Google Threat Intelligence (GTI MCP) Configuration
# Populate GTI_API_KEY (or VT_APIKEY) to enable live CTI enrichment tools.
GTI_API_KEY=<TODO: update-this-value>
VT_APIKEY=<TODO: update-this-value>
GTI_MCP_COMMAND=uvx
GTI_MCP_ARGS=gti-mcp
GTI_MCP_URL=<TODO: update-this-value>
